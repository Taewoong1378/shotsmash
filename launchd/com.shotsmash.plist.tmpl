<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shotsmash</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SHOTSMASH_BIN__</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>__WATCH_DIR__</string>
    </array>

    <key>StartInterval</key>
    <integer>30</integer>

    <key>ThrottleInterval</key>
    <integer>1</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/shotsmash.out</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/shotsmash.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
    </dict>
</dict>
</plist>
